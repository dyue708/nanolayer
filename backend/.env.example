# ============================================
# 服务器配置
# ============================================
PORT=3000
# 前端访问地址：CORS 来源；飞书 OAuth 回调为「本地址 + /」（须在飞书开放平台「重定向 URL」填写同一地址）
FRONTEND_URL=http://localhost:5173

# ============================================
# 数据库配置
# ============================================
# 数据库类型：sqlite 或 postgres
# 默认使用 sqlite，无需额外配置
DB_TYPE=sqlite

# PostgreSQL 配置（当 DB_TYPE=postgres 时使用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nanolayer
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ============================================
# Fal AI 平台配置
# ============================================
FAL_KEY=your_fal_api_key

# ============================================
# Google Vertex AI 配置（可选，用于直接调用 Vertex 源）
# 支持的模型：fal-ai/nano-banana、fal-ai/nano-banana-pro、fal-ai/nano-banana-2
# ============================================
# GCP 项目 ID（必填，启用 Vertex 时）
VERTEX_AI_PROJECT=your-gcp-project-id
# Vertex AI 区域（默认 us-east5，支持图像生成的区域）
VERTEX_AI_LOCATION=us-east5
# 服务账号 JSON 文件路径（本地开发用）；生产环境建议使用 Workload Identity
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# VERTEX_KEY_PATH=/path/to/service-account.json

# Vertex 模型映射（与 vertexService.ts 默认一致，可按区域/可用性覆盖）
VERTEX_MODEL_NANO_BANANA=gemini-2.5-flash-image
VERTEX_MODEL_NANO_BANANA_PRO=gemini-3-pro-image-preview
VERTEX_MODEL_NANO_BANANA_2=gemini-3.1-flash-image-preview

# ============================================
# 阿里云 OSS 配置
# ============================================
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your_bucket_name

# ============================================
# 成本配置（每张图片的成本，单位：美元）
# ============================================
COST_NANO_BANANA=0.0396
COST_NANO_BANANA_PRO=0.134
COST_NANO_BANANA_EDIT=0.0396
COST_NANO_BANANA_PRO_EDIT=0.134
# Seedream 5 Lite（fal.ai 源，每张 $0.035）
COST_SEEDREAM_V5_LITE=0.035
COST_SEEDREAM_V5_LITE_EDIT=0.035
# Vertex 源成本（每张输出图，美元）
# 定价来源：https://cloud.google.com/vertex-ai/generative-ai/pricing#gemini-models-3
# nano-banana → Gemini 2.5 Flash Image，1024 输出约 $0.039/张
# nano-banana-pro → Gemini 3 Pro Image Preview，1K/2K 输出 $0.134/张
# nano-banana-2 → Gemini 3.1 Flash Image Preview，1K 输出 $0.067/张（2K $0.101，4K $0.15）
COST_VERTEX_NANO_BANANA=0.039
COST_VERTEX_NANO_BANANA_EDIT=0.039
COST_VERTEX_NANO_BANANA_PRO=0.134
COST_VERTEX_NANO_BANANA_PRO_EDIT=0.134
COST_VERTEX_NANO_BANANA_2=0.067
COST_VERTEX_NANO_BANANA_2_EDIT=0.067

# ============================================
# 飞书认证配置（可选）
# ============================================
# 应用凭证（OAuth 换票与 authen.v1.user_info 所需）
# FEISHU_APP_ID=your_feishu_app_id
# FEISHU_APP_SECRET=your_feishu_app_secret
# 仅当 OAuth 回调与 FRONTEND_URL/ 不一致时再单独配置（一般不必）
# FEISHU_REDIRECT_URI=http://localhost:5173/
# 允许访问 API 的租户：填写开放平台用户信息里的 tenant_key；多个用英文逗号分隔
# 配置后，/api/images（除 /proxy）、/api/analysis 需携带 Authorization: Bearer <user_access_token>
# FEISHU_ALLOWED_TENANT_KEY=your_tenant_key
# 应用会话（登录后签发，默认 24h；24h 内刷新页面无需重新走飞书 OAuth）
# FEISHU_SESSION_TTL_SECONDS=86400
# FEISHU_SESSION_SECRET=随机长字符串   # 建议单独配置；未设置时回退 JWT_SECRET 或 FEISHU_APP_SECRET
# JWT_SECRET=your_jwt_secret # 废弃 备用字段 当 FEISHU_SESSION_SECRET 未设置时回退使用